<fsmddescription>

  <statelist>
    <state>OFF</state>
    <state>INIT</state>
    <state>STANDBY</state>
    <state>COOK</state>
    <state>DELAY</state>
    <state>KEEP_WARM</state>
    <state>AI_CALC</state>
  </statelist>

  <initialstate>INIT</initialstate>

  <inputlist>
    <input>start_button</input>
    <input>onehr_delay_button</input>
    <input>twohr_delay_button</input>
    <input>ai_delay_button</input>
    <input>weight</input>
    <input>keep_warm_button</input>
    <input>on_off_button</input>
  </inputlist>

  <variablelist>
    <variable>heating_elem</variable>
    <variable>delay_time</variable>
    <variable>keep_warm</variable>
    <variable>temp</variable>
    <variable>temp_step</variable>
  </variablelist>

  <operationlist>
    <operation>
      <name>heating_elem_on</name>
      <expression>heating_elem = 1</expression>
    </operation>
    <operation>
      <name>heating_elem_off</name>
      <expression>heating_elem = 0</expression>
    </operation>
    <operation>
      <name>set_delay_time_onehr</name>
      <expression>delay_time = 60</expression>
    </operation>
    <operation>
      <name>set_delay_time_twohr</name>
      <expression>delay_time = 120</expression>
    </operation>
    <operation>
      <name>init_delay_time</name>
      <expression>delay_time = 0</expression>
    </operation>
    <operation>
      <name>init_keep_warm</name>
      <expression>keep_warm = keep_warm_button</expression>
    </operation>
    <operation>
      <name>init_heating_elem</name>
      <expression>heating_elem = 0</expression>
    </operation>
    <operation>
      <name>init_temp</name>
      <expression>temp = 20</expression>
    </operation>
    <operation>
      <name>delay_decr</name>
      <expression>delay_time = delay_time - 1</expression>
    </operation>
    <operation>
      <name>temp_incr</name>
      <expression>temp = temp + 4</expression>
    </operation>
    <operation>
      <name>ai_delay_calc</name>
      <expression>delay_time = delay_time - 20 - ((weight - 200) / 50)</expression>
    </operation>
    <operation>
      <name>shift_temp</name>
      <expression>temp = temp - ((weight - 200) / 50)</expression>
    </operation>
    </operationlist>

  <conditionlist>
    <condition>
      <name>temp_fin</name>
      <expression>temp >= 100</expression>
    </condition>
    <condition>
      <name>delay_complete</name>
      <expression>delay_time == 0</expression>
    </condition>
    <condition>
      <name>start_pushed</name>
      <expression>start_button == 1</expression>
    </condition>
    <condition>
      <name>on_off_pushed</name>
      <expression>on_off_button == 1</expression>
    </condition>
    <condition>
      <name>onehr_delay_pushed</name>
      <expression>onehr_delay_button == 1</expression>
    </condition>
    <condition>
      <name>twohr_delay_pushed</name>
      <expression>twohr_delay_button == 1</expression>
    </condition>
    <condition>
      <name>ai_delay_pushed</name>
      <expression>ai_delay_button == 1</expression>
    </condition>
    <condition>
      <name>keep_warm_on</name>
      <expression>keep_warm == 1</expression>
    </condition>
  </conditionlist>

  <fsmd>
    <INIT>
      <transition>
        <condition>True</condition>
        <instruction>init_heating_elem init_delay_time init_keep_warm init_temp</instruction>
        <nextstate>STANDBY</nextstate>
      </transition>
    </INIT>

    <STANDBY>
      <transition>
        <condition>on_off_pushed</condition>
        <instruction>NOP</instruction>
        <nextstate>OFF</nextstate>
      </transition>
      <transition>
        <condition>ai_delay_pushed</condition>
        <instruction>init_keep_warm</instruction>
        <nextstate>AI_CALC</nextstate>
      </transition>
      <transition>
        <condition>onehr_delay_pushed</condition>
        <instruction>set_delay_time_onehr init_keep_warm</instruction>
        <nextstate>DELAY</nextstate>
      </transition>
      <transition>
        <condition>twohr_delay_pushed</condition>
        <instruction>set_delay_time_twohr init_keep_warm</instruction>
        <nextstate>DELAY</nextstate>
      </transition>
      <transition>
        <condition>start_pushed</condition>
        <instruction>heating_elem_on init_keep_warm</instruction>
        <nextstate>COOK</nextstate>
      </transition>
    </STANDBY>

    <DELAY>
      <transition>
        <condition>delay_complete</condition>
        <instruction>heating_elem_on</instruction>
        <nextstate>COOK</nextstate>
      </transition>
      <transition>
        <condition>True</condition>
        <instruction>delay_decr</instruction>
        <nextstate>DELAY</nextstate>
      </transition>
    </DELAY>

    <COOK>
      <transition>
        <condition>temp_fin</condition>
        <instruction>NOP</instruction>
        <nextstate>KEEP_WARM</nextstate>
      </transition>
      <transition>
        <condition>True</condition>
        <instruction>temp_incr</instruction>
        <nextstate>COOK</nextstate>
      </transition>
    </COOK>

    <KEEP_WARM>
      <transition>
        <condition>keep_warm_on</condition>
        <instruction>NOP</instruction>
        <nextstate>KEEP_WARM</nextstate>
      </transition>
      <transition>
        <condition>on_off_pushed</condition>
        <instruction>NOP</instruction>
        <nextstate>OFF</nextstate>
      </transition>
      <transition>
        <condition>True</condition>
        <instruction>NOP</instruction>
        <nextstate>INIT</nextstate>
      </transition>
    </KEEP_WARM>

    <AI_CALC>
      <transition>
        <condition>onehr_delay_button</condition>
        <instruction>set_delay_time_onehr ai_delay_calc shift_temp</instruction>
        <nextstate>DELAY</nextstate>
      </transition>
      <transition>
        <condition>twohr_delay_button</condition>
        <instruction>set_delay_time_twohr ai_delay_calc shift_temp</instruction>
        <nextstate>DELAY</nextstate>
      </transition>
      <transition>
        <condition>True</condition>
        <instruction>heating_elem_on</instruction>
        <nextstate>COOK</nextstate>
      </transition>
    </AI_CALC>


    <OFF>
      <transition>
        <condition>True</condition>
        <instruction>NOP</instruction>
        <nextstate>OFF</nextstate>
      </transition>
    </OFF>

  </fsmd>

</fsmddescription>
