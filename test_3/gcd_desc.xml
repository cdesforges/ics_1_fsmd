<fsmddescription>

  <statelist>
    <state>INIT</state>
    <state>STANDBY</state>
    <state>COOK</state>
    <state>DELAY</state>
    <state>KEEPWARM</state>
    <state>OFF</state>
  </statelist>

  <initialstate>INIT</initialstate>

  <inputlist>
    <input>start_button</input>
    <input>temp</input>
    <input>1_hr_delay_button</input>
    <input>2_hr_delay_button</input>
    <input>keep_warm_button</input>
    <input>on_off_button</input>
  </inputlist>

  <variablelist>
    <variable>hearting_elem</variable>
    <variable>delay_time</variable>
    <variable>keep_warm</variable>
  </variablelist>

  <operationlist>
    <operation>
      <name>heating_elem_on</name>
      <expression>heating_elem = 1</expression>
    </operation>
    <operation>
      <name>heating_elem_off</name>
      <expression>heating_elem = 0</expression>
    </operation>
    <operation>
      <name>set_delay_time_1_hr</name>
      <expression>delay_time = 60</expression>
    </operation>
    <operation>
      <name>set_delay_time_2_hr</name>
      <expression>delay_time = 120</expression>
    </operation>
    <operation>
      <name>set_keep_warm</name>
      <expression>keep_warm = keep_warm_button</expression>
    </operation>
    </operationlist>

  <conditionlist>
    <condition>
      <name>temp_fin</name>
      <expression>temp >= 100</expression>
    </condition>
    <condition>
      <name>delay_time</name>
      <expression>var_A &gt; var_B</expression>
    </condition>
    <condition>
      <name>B_greater_A</name>
      <expression>var_A &lt; var_B</expression>
    </condition>
  </conditionlist>

  <fsmd>
    <INITIALIZE>
      <transition>
        <condition>True</condition>
        <instruction>init_A init_B init_C</instruction>
        <nextstate>TEST</nextstate>
      </transition>
    </INITIALIZE>

    <TEST>
      <transition>
        <condition>A_equal_B</condition>
        <instruction>NOP</instruction>
        <nextstate>FINISH</nextstate>
      </transition>
      <transition>
        <condition>A_greater_B</condition>
        <instruction>NOP</instruction>
        <nextstate>ADIVC</nextstate>
      </transition>
      <transition>
        <condition>B_greater_A</condition>
        <instruction>NOP</instruction>
        <nextstate>BDIVC</nextstate>
      </transition>
    </TEST>

    <ADIVC>
      <transition>
        <condition>True</condition>
        <instruction>A_div_C</instruction>
        <nextstate>TEST</nextstate>
      </transition>
    </ADIVC>

    <BDIVC>
      <transition>
        <condition>True</condition>
        <instruction>B_div_C</instruction>
        <nextstate>TEST</nextstate>
      </transition>
    </BDIVC>

    <FINISH>
      <transition>
        <condition>True</condition>
        <instruction>NOP</instruction>
        <nextstate>FINISH</nextstate>
      </transition>
    </FINISH>
  </fsmd>

</fsmddescription>
